# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA suba o arquivo ".env" preenchido para o GitHub — ele já está no .gitignore.

# ─── Google Gemini (extração e chat) ───
GEMINI_API_KEY=sua_api_key_aqui

# ─── Google Sheets / Drive (OAuth2) ───
GOOGLE_OAUTH_CLIENT_ID=seu_client_id_aqui
GOOGLE_OAUTH_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_SHEETS_ID=id_da_sua_planilha_aqui

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui

# ─── n8n (execução local) ───
WEBHOOK_URL=https://sua-url-do-ngrok.ngrok-free.dev/
N8N_RESTRICT_FILE_ACCESS_TO=C:\caminho\para\sua\pasta\de\boletos

# ─── Pasta local de boletos (apenas referência, não versionar os PDFs) ───
BOLETOS_FOLDER_PATH=C:\caminho\para\sua\pasta\de\boletos
